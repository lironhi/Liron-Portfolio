# Groq API Configuration — chatbot (app/api/chat)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional — primary model (default openai/gpt-oss-120b, falls back to gpt-oss-20b).
# Groq retires models without notice; list the live ones with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — per-visitor daily question cap (default 40 in production, off locally).
# Setting it also switches the cap on in development.
# CHAT_DAILY_LIMIT=40

# Optional — shared rate-limit counters across serverless instances. Without them
# each instance counts on its own, so the daily cap is only approximate on Vercel.
# Create a free Upstash Redis database (Vercel Marketplace or upstash.com); the
# Vercel integration may name these KV_REST_API_URL / KV_REST_API_TOKEN instead.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token

# Optional — key that signs the chatbot's answers so a forged history is rejected.
# Derived from GROQ_API_KEY when unset; rotating either just forgets old turns.
# CHAT_SIGNING_SECRET=any_long_random_string

# Admin page (/admin) — HTTP Basic auth, any user name.
# Unset: /admin is open in development and a 404 in production.
# ADMIN_PASSWORD=choose_a_long_password

# Web3Forms — contact form (app/api/contact)
# Without this the contact form answers 500 "Server configuration error".
# Get a free access key at: https://web3forms.com
# Note: only read server-side despite the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Optional — Google Search Console verification (app/layout.tsx metadata)
# GOOGLE_SITE_VERIFICATION=your_verification_token_here
