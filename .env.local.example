# Groq API Configuration — chatbot (app/api/chat)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional — primary model (default openai/gpt-oss-120b, falls back to gpt-oss-20b).
# Groq retires models without notice; list the live ones with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=openai/gpt-oss-120b

# Web3Forms — contact form (app/api/contact)
# Without this the contact form answers 500 "Server configuration error".
# Get a free access key at: https://web3forms.com
# Note: only read server-side despite the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Optional — Google Search Console verification (app/layout.tsx metadata)
# GOOGLE_SITE_VERIFICATION=your_verification_token_here
